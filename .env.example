# Copy this file to .env and fill in real values before running the app
# or scripts/setup-db.mjs. Never commit your real .env file.

# --- Database (required) ---------------------------------------------------
# Neon Postgres connection string. Create a project at https://neon.tech,
# then run: node scripts/setup-db.mjs --seed   (first time only — creates
# tables and seeds real launch content for the Louvre, Duomo Florence,
# Uffizi Gallery, and Lindt Home of Chocolate). Every later run should omit
# --seed so it only applies schema migrations and never re-adds deleted data.
DATABASE_URL=

# --- Admin login (required) -------------------------------------------------
# The "owner" account — always valid, can't be deleted, works even if the
# users table is empty. Change ADMIN_PASSWORD any time by redeploying; it
# stays valid as a break-glass credential even after you've also set a
# password through /admin/account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret used to sign admin session cookies (HMAC-SHA256). Set this to a
# long random string in production — sessions are self-signed tokens, not
# stored server-side, so anyone with this secret could forge a session.
ADMIN_SESSION_SECRET=

# --- Nearby Attractions feature (optional) ----------------------------------
# Real routing (walking/driving minutes) via a self-hosted OSRM instance.
# Leave unset to use the free public OSRM demo server for driving directions
# (router.project-osrm.org — driving profile only, rate-limited, not for
# heavy production traffic) plus a distance/speed estimate for walking.
OSRM_BASE_URL=

# --- GetYourGuide affiliate links (recommended before launch) ---------------
# Your real GetYourGuide Partner ID. Every ticket/tour link on the site is
# built from this — see lib/museums.ts's gygLink(). Without it, links fall
# back to a placeholder partner_id and won't earn commission.
GYG_PARTNER_ID=

# --- Media uploads (recommended) --------------------------------------------
# Vercel Blob read/write token — powers the admin's image upload fields and
# Media Library. Add a Blob store to your Vercel project (Storage tab) to
# get this. Without it, uploads are disabled but pasting an external image
# URL still works everywhere.
BLOB_READ_WRITE_TOKEN=

# --- Analytics (optional) ---------------------------------------------------
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). The GA script is
# only injected when this is set — never ships a fake/placeholder ID.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Login captcha (optional) -----------------------------------------------
# Cloudflare Turnstile. Both must be set together to enable the captcha on
# /admin/login — the site key is public (shown to the browser), the secret
# key stays server-side. Without them, the captcha widget doesn't render and
# the server-side check is skipped entirely (not enforced).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
